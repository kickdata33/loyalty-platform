{
  "name": "loyalty-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:emulator": "firebase emulators:exec --only auth,firestore \"vitest run tests/emulator tests/security-rules\"",
    "test:all": "npm run test && npm run test:emulator",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:functions": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "@line/liff": "^2.29.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "jsqr": "^1.4.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.27.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
