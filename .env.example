# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit it.
#
# Firebase Web App config (client-side, safe to expose to the browser — these are not secrets).
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
# (dev project: loyalty-platform-dev-9a0c5).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Uncomment to point the app (client + Admin SDK) at local Firebase Emulators instead of the real
# dev project. Start emulators first with `npm run emulators`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase Admin SDK (server-side only) does NOT read config from env vars here — it uses
# Application Default Credentials. For local/Codespaces dev against the real dev project, run
# `gcloud auth application-default login` once, or set GOOGLE_APPLICATION_CREDENTIALS to point at
# a locally-stored, gitignored service account key. Never commit a service account key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/local/only/service-account-key.json
