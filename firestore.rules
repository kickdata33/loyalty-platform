rules_version = '2';

// Phase 1 Firestore Security Rules (FINAL-ARCHITECTURE.md §3, §5, §7, §9, §10, §26).
//
// Security Rules are defense-in-depth ONLY — the primary authorization boundary is server-side
// application code deriving merchantId/role from verified custom claims (§3, §10, §26). These
// rules exist to make sure that even a real-time client listener reading its own data directly
// can never cross a tenant boundary, and that no business-sensitive write is ever possible from
// the client. Every collection below denies ALL client writes — every write in this codebase goes
// through server-side service functions using the Admin SDK, which bypasses these rules entirely
// by design (Admin SDK is trusted server code, not subject to Security Rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    // "Active staff of merchantId" — role/merchantId claims are set exclusively by the
    // onStaffUserWrite Cloud Function trigger (§8, §10, §32), never by the client, so trusting
    // request.auth.token here for a *read-only* allow is safe.
    function isActiveStaffOfMerchant(merchantId) {
      return isSignedIn()
        && request.auth.token.merchantId == merchantId
        && request.auth.token.role in ['OWNER', 'MANAGER', 'STAFF'];
    }

    // platformCustomers / customerIdentities — 100% deny-all client access, no exceptions, not
    // even Super Admin through the normal client SDK (§6, §7: "ไม่มี client อ่านได้เลย แม้แต่
    // Super Admin ผ่าน UI ปกติ"). Only Admin SDK server code ever touches these.
    match /platformCustomers/{customerId} {
      allow read, write: if false;
    }
    match /customerIdentities/{identityId} {
      allow read, write: if false;
    }

    // auditLogs — append-only, server-only, no client read or write ever (§18). Even Super Admin
    // reads audit history through a dedicated server-side view in a later phase, not raw client
    // reads of this collection.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // merchants/{merchantId} + branches — readable by that merchant's own active staff (or
    // superAdmin); all writes are server-only (settings/branding changes go through the service
    // layer so they can be validated, permission-checked, and audited).
    match /merchants/{merchantId} {
      allow read: if isActiveStaffOfMerchant(merchantId) || isSuperAdmin();
      allow write: if false;

      match /branches/{branchId} {
        allow read: if isActiveStaffOfMerchant(merchantId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // staffUsers/{staffUserId} — readable only by staff of the SAME merchant as the document
    // (not the reader's own claims path, since staff list membership is a property of the
    // resource, not the requester). Writes are server-only; the only code that ever writes here
    // is the staff service layer, and the only code that reacts to those writes is
    // onStaffUserWrite (functions/src/index.ts) — this rule guarantees no other path exists.
    match /staffUsers/{staffUserId} {
      allow read: if isActiveStaffOfMerchant(resource.data.merchantId) || isSuperAdmin();
      allow write: if false;
    }

    // memberships/{membershipId} — same pattern: readable by staff of the membership's own
    // merchant, never cross-tenant. Business-sensitive writes (points, profile, tags, ...) are
    // always server-only (§26).
    match /memberships/{membershipId} {
      allow read: if isActiveStaffOfMerchant(resource.data.merchantId) || isSuperAdmin();
      allow write: if false;
    }

    // subscriptions/{merchantId} — readable by that merchant's own staff (any role may see their
    // own plan/status even though only Owner can change it, §9); writes are Super-Admin-only
    // server actions (§25).
    match /subscriptions/{merchantId} {
      allow read: if isActiveStaffOfMerchant(merchantId) || isSuperAdmin();
      allow write: if false;
    }

    // packages/{packageId} — public read for any signed-in user (needed to display plan
    // comparisons); managed by Super Admin only, server-side (§25).
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Phase 3 — Points (§5, §11, §12, §15, §26, §27). All seven collections below are 100%
    // deny-all client read/write, by design: unlike merchants/staffUsers/memberships, the Staff
    // Portal never reads these directly via the client Firestore SDK — every points/rules/
    // history/visit/event read and every write goes through the protected API routes (Admin SDK,
    // server-authorized), same "server is the only path" pattern the Phase 2 review locked in for
    // the dashboard. pointsLedger/pointsLots/pointsLotConsumptions are
    // append-only-or-controlled-mutation collections (§12) — there is no scenario where a client
    // should read or write them directly.
    match /pointRules/{ruleId} {
      allow read, write: if false;
    }
    match /pointsLedger/{entryId} {
      allow read, write: if false;
    }
    match /pointsLots/{lotId} {
      allow read, write: if false;
    }
    match /pointsLotConsumptions/{consumptionId} {
      allow read, write: if false;
    }
    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }
    match /visits/{visitId} {
      allow read, write: if false;
    }
    // events — immutable business-fact log driving the (not-yet-built) Automation Engine/Reports
    // (§17). Written atomically alongside the state change inside the same transaction as every
    // pointsLedger/visits write above — deny-all client access for the same reason.
    match /events/{eventId} {
      allow read, write: if false;
    }

    // Phase 4 — Rewards (§5, §13, §26). Same "server is the only path" reasoning as Phase 3 —
    // Redeem/Use are transactional, staff-limit-adjacent operations (stock decrement, FIFO points
    // spend, voucher status transition) that must go through the protected API routes, never a
    // direct client write.
    match /rewardTemplates/{rewardId} {
      allow read, write: if false;
    }
    match /voucherInstances/{voucherId} {
      allow read, write: if false;
    }

    // Phase 5 — Coupons (§5, §14, §26). Same "server is the only path" reasoning as Reward —
    // Issue/Redeem are transactional operations (Total/Per-Member Limit checks, status
    // transition) that must go through the protected API routes, never a direct client write.
    match /couponTemplates/{couponId} {
      allow read, write: if false;
    }
    match /couponInstances/{instanceId} {
      allow read, write: if false;
    }

    // Phase 6 — Promotion/Automation (§5, §16, §17). Same "server is the only path" reasoning —
    // CRUD, execution, and safety-limit checks all go through the protected API routes / Cloud
    // Functions (Admin SDK), never a direct client write.
    match /automations/{automationId} {
      allow read, write: if false;
    }
    match /automationActionExecutions/{executionKey} {
      allow read, write: if false;
    }

    // Phase 7 — LINE / Notifications (§5, §19, §23, §26). Credential-adjacent and message-
    // delivery collections — server/Cloud-Function-only, same "server is the only path" reasoning
    // as every prior phase's business-state collections. `lineChannelConfigs` in particular must
    // never be client-readable even in part, since it holds Secret Manager references.
    match /lineChannelConfigs/{merchantId} {
      allow read, write: if false;
    }
    match /notificationSettings/{merchantId} {
      allow read, write: if false;
    }
    match /notificationLog/{logId} {
      allow read, write: if false;
    }

    // Phase 8 — Reports (§5, §24, §26). Same "server is the only path" reasoning as every prior
    // phase — the Dashboard reads `merchantDailyStats`/`reports` through the protected API routes
    // (`/api/reports`, `/api/report-settings`) only, never a direct client Firestore read/write.
    // `reports` is additionally the FROZEN Snapshot record (§24) — no update/delete path exists
    // anywhere in this codebase, client or server, once written.
    match /merchantDailyStats/{statsId} {
      allow read, write: if false;
    }
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Phase 9 — Platform Admin (§37, §26). `supportSessions`/`emergencyControls` are 100%
    // deny-all client access, no exceptions, not even Super Admin through the normal client SDK —
    // same tier as `platformCustomers`/`customerIdentities` (§6): opening/closing/reading a
    // Support Session and toggling an Emergency Control both go through server-side service
    // functions only (`@/modules/support-session/service`, `@/modules/emergency-control/service`),
    // never a direct client read/write, so every use is guaranteed to be audited (§18, §37.1,
    // §37.2) — a direct client read path would bypass that guarantee entirely.
    match /supportSessions/{sessionId} {
      allow read, write: if false;
    }
    match /emergencyControls/{merchantId} {
      allow read, write: if false;
    }
    // systemHealth — Super-Admin-only read (same pattern as merchants/subscriptions, §3); written
    // only by the scheduled self-check Cloud Function (Admin SDK, bypasses these rules).
    match /systemHealth/{component} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Phase 10 — Hardening (§38, §26). `broadcasts` is server-only (rate-limit source of truth —
    // the Dashboard reads broadcast history through `getBroadcastReport`/the protected API route,
    // never a direct client read, same "server is the only path" reasoning as `notificationLog`).
    // `platformOpsSettings`/`criticalErrors` are 100% deny-all, no exceptions, not even Super
    // Admin through the normal client SDK — same tier as `supportSessions`/`emergencyControls`
    // (§37): the critical-alert recipient and system-error history are only ever read/written
    // through server-side service functions (`@/modules/ops-alert/service`), so every use is
    // guaranteed to be audited/traced, never bypassable via a direct client read.
    match /broadcasts/{broadcastId} {
      allow read, write: if false;
    }
    match /platformOpsSettings/{docId} {
      allow read, write: if false;
    }
    match /criticalErrors/{errorId} {
      allow read, write: if false;
    }

    // Everything else stays denied by Firestore's own default (no matching rule = no access) —
    // deliberately no catch-all `match /{document=**}` here to keep this file limited to the
    // collections that actually exist; add a new explicit match block, not a broad wildcard, when
    // a later phase introduces a new collection.
  }
}
